name: Deploy frontend-study to GitHub Pages

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: github-pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
          cache-dependency-path: |
            react/react-netflix/package-lock.json

      - name: Prepare static site
        run: |
          rm -rf _site
          mkdir -p _site

          rsync -a ./ _site/ \
            --exclude='.git' \
            --exclude='.github' \
            --exclude='_site' \
            --exclude='**/node_modules' \
            --exclude='**/build' \
            --exclude='**/dist' \
            --exclude='**/.cache' \
            --exclude='**/.vite' \
            --exclude='**/.env' \
            --exclude='**/.env.local'

          touch _site/.nojekyll

      - name: Build React Netflix
        working-directory: react/react-netflix
        env:
          CI: false
        run: |
          npm ci
          npm run build
          rm -rf ../../_site/react/react-netflix
          mkdir -p ../../_site/react/react-netflix
          cp -a build/. ../../_site/react/react-netflix/

      - name: Build React Movie List
        working-directory: react/react-movie-list
        env:
          CI: false
        run: |
          npm ci
          npm run build
          rm -rf ../../_site/react/react-movie-list
          mkdir -p ../../_site/react/react-movie-list
          cp -a build/. ../../_site/react/react-movie-list/

      - name: Build React animation
        working-directory: react/react-animationt
        env:
          CI: false
        run: |
          npm ci
          npm run build
          rm -rf ../../_site/react/react-animation
          mkdir -p ../../_site/react/react-animation
          cp -a build/. ../../_site/react/react-animation/

      - name: Build React coin-list
        working-directory: react/react-coin-list
        env:
          CI: false
        run: |
          npm ci
          npm run build
          rm -rf ../../_site/react/react-coin-list
          mkdir -p ../../_site/react/react-coin-list
          cp -a build/. ../../_site/react/react-coin-list/

      - name: Build React lottery
        working-directory: react/react-lottery
        env:
          CI: false
        run: |
          npm ci
          npm run build
          rm -rf ../../_site/react/react-lottery
          mkdir -p ../../_site/react/react-lottery
          cp -a build/. ../../_site/react/react-lottery/

      # 다른 React/Vue/Svelte 프로젝트도 자동 빌드하고 싶다면 아래 형식으로 추가합니다.
      # - name: Build React Movie List
      #   working-directory: react/react-movie-list
      #   env:
      #     CI: false
      #   run: |
      #     npm ci
      #     npm run build
      #     rm -rf ../../_site/react/react-movie-list
      #     mkdir -p ../../_site/react/react-movie-list
      #     cp -a build/. ../../_site/react/react-movie-list/

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload GitHub Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: _site

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build

    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
